# AI Marketing & Sales Automation Tool
# Environment Configuration

# OpenAI API (For marketing content generation)
OPENAI_API_KEY=your_openai_api_key_here
CHATGPT_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# Google Ads API (For advertising campaigns)
GOOGLE_ADS_API_KEY=your_google_ads_api_key_here
GOOGLE_ADS_API=https://googleads.googleapis.com/v15
GOOGLE_ADS_CUSTOMER_ID=your_customer_id_here

# HubSpot API (For sales & CRM integration)
HUBSPOT_API_KEY=your_hubspot_api_key_here
HUBSPOT_API=https://api.hubapi.com

# Anthropic API (Alternative AI provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_API=https://api.anthropic.com

# Timeout configurations (in milliseconds)
MARKETING_API_TIMEOUT=10000
ADVERTISING_API_TIMEOUT=10000
SALES_API_TIMEOUT=10000

# Application settings
NODE_ENV=development
LOG_LEVEL=info
DEBUG_MODE=false

# Campaign defaults
DEFAULT_CAMPAIGN_BUDGET=5000
DEFAULT_CAMPAIGN_DURATION=30
DEFAULT_TARGET_AUDIENCE=general

# API Rate limits
OPENAI_RATE_LIMIT=100
GOOGLE_ADS_RATE_LIMIT=200
HUBSPOT_RATE_LIMIT=500

# Feature flags
ENABLE_EMAIL_AUTOMATION=true
ENABLE_SOCIAL_MEDIA=true
ENABLE_LEAD_SCORING=true
ENABLE_ANALYTICS_DASHBOARD=true
